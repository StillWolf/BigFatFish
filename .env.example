# install.sh 会隐藏输入 API Key，并为本地接口生成随机 token。
DEEPSEEK_API_KEY=
ONEBOT_ACCESS_TOKEN=
NAPCAT_WEBUI_TOKEN=
WECHAT_AI_MCP_TOKEN=
WECHAT_DESKTOP_PASSWORD=
# 运行时/镜像版本与访问端口。服务默认仅发布到本机回环地址。
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
FISH_WEB_PORT=3080
NAPCAT_WEB_PORT=6099
BILIBILI_WEB_PORT=6082
WECHAT_WEB_PORT=6081
FISH_INSTALL_BILIBILI=1
FISH_ASR_MODEL=small
HF_ENDPOINT=https://huggingface.co
COMPOSE_PROFILES=
